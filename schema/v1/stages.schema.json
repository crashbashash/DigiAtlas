          },
          "area": {
            "type": [
              "string",
              "null"
            ],
            "description": "World as printed on the loading banner, e.g. Death Valley."
          },
          "room": {
            "type": [
              "string",
              "null"
            ],
            "description": "Room or dungeon name as printed on the loading banner. Null for unnamed system scenes."
          },
          "kind": {
            "enum": [
              "field",
              "dungeon",
              "boss",
              "hub",
              "system"
            ]
          },
          "floor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dungeon floor from the id: B1, B2 or F1 (b and f are the game's own letters)."
          },
          "variant": {
            "enum": [
              "e",
              "h",
              "v",
              null
            ],
            "description": "Trailing letter on the side dungeons (dngq*); its meaning is not confirmed."
          },
          "banner": {
            "type": [
              "string",
              "null"
            ],
            "description": "Loading-screen picture, relative to the export directory."
          },
          "map": {
            "type": [
              "object",
              "null"
            ],
            "description": "Top-down terrain map, present when the export was run with --maps and the stage has spawn points.",
            "additionalProperties": false,
            "required": [
              "image",
              "bounds",
              "width",
              "height",
              "pixelsPerUnit",
              "coverage",
              "fill"
            ],
            "properties": {
              "image": {
                "type": "string",
                "description": "PNG relative to the export directory; transparent where there is no geometry."
              },
              "bounds": {
                "type": "object",
                "required": [
                  "minX",
                  "maxX",
                  "minZ",
                  "maxZ"
                ],
                "additionalProperties": false,
                "properties": {
                  "minX": {
                    "type": "number"
                  },
                  "maxX": {
                    "type": "number"
                  },
                  "minZ": {
                    "type": "number"
                  },
                  "maxZ": {
                    "type": "number"
                  }
                },
                "description": "World rectangle the image covers. Image x grows with world x and image y grows with world z."
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "pixelsPerUnit": {
                "type": "number",
                "description": "Pixels per world unit: pixel = (world - min) * pixelsPerUnit."
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Share of spawn points that land on drawn geometry."
              },
              "fill": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Share of the image covered by geometry. Values near 1 (boss arenas, a few dungeon floors) are flat floors with little structure to show."
              }
            }
          },
          "trades": {
            "type": "array",
            "description": "Item traders in this room (Trader Hall). Each is a Digimon who swaps one item you hold for another.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trader",
                "number",
                "offers"
              ],
              "properties": {
                "trader": {
                  "type": "string",
                  "description": "Display name of the Digimon."
                },
                "number": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Which of several traders of the same Digimon (1, 2, ...); null when there is one."
                },
                "offers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "give",
                      "get"
                    ],
                    "properties": {
                      "give": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "category",
                          "id"
                        ],
                        "properties": {
                          "category": {
                            "enum": [
                              "weapon",
                              "armor1",
                              "armor2",
                              "abChip",
                              "conItem",
                              "insItem",
                              "impItem"
                            ],
                            "description": "Item database; with `id` it is the key of an entry in items.json."
                          },
                          "id": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      },
                      "get": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "category",
                          "id"
                        ],
                        "properties": {
                          "category": {
                            "enum": [
                              "weapon",
                              "armor1",
                              "armor2",
                              "abChip",
                              "conItem",
                              "insItem",
                              "impItem"
                            ],
                            "description": "Item database; with `id` it is the key of an entry in items.json."
                          },
                          "id": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
