{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiatlas.invalid/schema/v1/stages.schema.json",
  "title": "Stages and spawn generators",
  "type": "object",
  "required": [
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manifestEntry",
          "packs",
          "generatorPacks",
          "difficulties",
          "area",
          "room",
          "kind",
          "floor",
          "variant",
          "banner",
          "map",
          "trades"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Engine stage id, e.g. stagGF01, dng101b1."
          },
          "manifestEntry": {
            "type": "integer"
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "generatorPacks": {
            "type": [
              "object",
              "null"
            ],
            "description": "difficulty -> source archive entry (platform specific).",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "difficulties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "normal": {
                "type": "object",
                "required": [
                  "generators"
                ],
                "properties": {
                  "generators": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "row",
                        "count",
                        "maxCount",
                        "rotations",
                        "startMode",
                        "fillMode",
                        "spawns"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "GENE-* enemies, GBOX-* boxes, GBRL-* barrels, GWCS-* crates."
                        },
                        "row": {
                          "type": "integer",
                          "description": "Enemy stat row (enemies.json) spawned by this generator."
                        },
                        "count": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "maxCount": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "rotations": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "startMode": {
                          "type": "string"
                        },
                        "fillMode": {
                          "type": "string"
                        },
                        "lua": {
                          "type": "string"
                        },
                        "drops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "lastDrops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "spawns": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "minItems": 1,
                          "description": "World positions [x, y, z] where this generator places enemies or objects. For dungeon rooms the game stores offsets from a room anchor; they are already added here."
                        },
                        "trigger": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "center",
                            "radius"
                          ],
                          "description": "Radar spawners only: the spawner starts once a player is within `radius` units of `center`.",
                          "properties": {
                            "center": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 3,
                              "maxItems": 3
                            },
                            "radius": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          }
                        },
                        "players": {
                          "type": "array",
                          "minItems": 4,
                          "maxItems": 4,
                          "description": "Present only when the numbers change with the number of players: entry 0 is one player, entry 3 is four. Without it the fields above apply to every player count.",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "count",
                              "maxCount"
                            ],
                            "properties": {
                              "count": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "maxCount": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "drops": {
                                "type": "object",
                                "additionalProperties": {
                                  "type": "string"
                                },
                                "description": "difficulty (or slotN) -> pool name in drops.json"
                              },
                              "lastDrops": {
                                "type": "object",
                                "additionalProperties": {
                                  "type": "string"
                                },
                                "description": "difficulty (or slotN) -> pool name in drops.json"
                              }
                            }
                          }
                        },
                        "script": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "status"
                          ],
                          "description": "What the stage's own scripts do with this spawner, from the decompiled scripts.",
                          "properties": {
                            "status": {
                              "enum": [
                                "referenced",
                                "dynamic",
                                "unknown",
                                "none"
                              ],
                              "description": "referenced: a script names it. dynamic: a script builds names (a loop) that match it. unknown: the stage has a script call whose spawner name cannot be read. none: no script mentions it."
                            },
                            "refs": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "verb",
                                  "when"
                                ],
                                "properties": {
                                  "verb": {
                                    "type": "string",
                                    "description": "START, RESTART, STOP and so on"
                                  },
                                  "when": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    },
                                    "description": "Conditions the call sits under, outermost first, in words where the function is known."
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "hard": {
                "type": "object",
                "required": [
                  "generators"
                ],
                "properties": {
