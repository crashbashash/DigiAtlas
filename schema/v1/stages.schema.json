{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiatlas.invalid/schema/v1/stages.schema.json",
  "title": "Stages and spawn generators",
  "type": "object",
  "required": [
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manifestEntry",
          "packs",
          "generatorPacks",
          "difficulties",
          "area",
          "room",
          "kind",
          "floor",
          "variant",
          "banner",
          "map"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Engine stage id, e.g. stagGF01, dng101b1."
          },
          "manifestEntry": {
            "type": "integer"
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "generatorPacks": {
            "type": [
              "object",
              "null"
            ],
            "description": "difficulty -> source archive entry (platform specific).",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "difficulties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "normal": {
                "type": "object",
                "required": [
                  "generators"
                ],
                "properties": {
                  "generators": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "row",
                        "count",
                        "maxCount",
                        "rotations",
                        "startMode",
                        "fillMode",
                        "spawns"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "GENE-* enemies, GBOX-* boxes, GBRL-* barrels, GWCS-* crates."
                        },
                        "row": {
                          "type": "integer",
                          "description": "Enemy stat row (enemies.json) spawned by this generator."
                        },
                        "count": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "maxCount": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "rotations": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "startMode": {
                          "type": "string"
                        },
                        "fillMode": {
                          "type": "string"
                        },
                        "lua": {
                          "type": "string"
                        },
                        "drops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "lastDrops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "spawns": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "minItems": 1,
                          "description": "World positions [x, y, z] where this generator places enemies or objects. For dungeon rooms the game stores offsets from a room anchor; they are already added here."
                        }
                      }
                    }
                  }
                }
              },
              "hard": {
                "type": "object",
                "required": [
                  "generators"
                ],
                "properties": {
                  "generators": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "row",
                        "count",
                        "maxCount",
                        "rotations",
                        "startMode",
                        "fillMode",
                        "spawns"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "GENE-* enemies, GBOX-* boxes, GBRL-* barrels, GWCS-* crates."
                        },
                        "row": {
                          "type": "integer",
                          "description": "Enemy stat row (enemies.json) spawned by this generator."
                        },
                        "count": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "maxCount": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "rotations": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "startMode": {
                          "type": "string"
                        },
                        "fillMode": {
                          "type": "string"
                        },
                        "lua": {
                          "type": "string"
                        },
                        "drops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "lastDrops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "spawns": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "minItems": 1,
                          "description": "World positions [x, y, z] where this generator places enemies or objects. For dungeon rooms the game stores offsets from a room anchor; they are already added here."
                        }
                      }
                    }
                  }
                }
              },
              "veryhard": {
                "type": "object",
                "required": [
                  "generators"
                ],
                "properties": {
                  "generators": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "row",
                        "count",
                        "maxCount",
                        "rotations",
                        "startMode",
                        "fillMode",
                        "spawns"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "GENE-* enemies, GBOX-* boxes, GBRL-* barrels, GWCS-* crates."
                        },
                        "row": {
                          "type": "integer",
                          "description": "Enemy stat row (enemies.json) spawned by this generator."
                        },
                        "count": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "maxCount": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "rotations": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "startMode": {
                          "type": "string"
                        },
                        "fillMode": {
                          "type": "string"
                        },
                        "lua": {
                          "type": "string"
                        },
                        "drops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "lastDrops": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "difficulty (or slotN) -> pool name in drops.json"
                        },
                        "spawns": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "minItems": 1,
                          "description": "World positions [x, y, z] where this generator places enemies or objects. For dungeon rooms the game stores offsets from a room anchor; they are already added here."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "area": {
            "type": [
              "string",
              "null"
            ],
            "description": "World as printed on the loading banner, e.g. Death Valley."
          },
          "room": {
            "type": [
              "string",
              "null"
            ],
            "description": "Room or dungeon name as printed on the loading banner. Null for unnamed system scenes."
          },
          "kind": {
            "enum": [
              "field",
              "dungeon",
              "boss",
              "hub",
              "system"
            ]
          },
          "floor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dungeon floor from the id: B1, B2 or F1 (b and f are the game's own letters)."
          },
          "variant": {
            "enum": [
              "e",
              "h",
              "v",
              null
            ],
            "description": "Trailing letter on the side dungeons (dngq*); its meaning is not confirmed."
          },
          "banner": {
            "type": [
              "string",
              "null"
            ],
            "description": "Loading-screen picture, relative to the export directory."
          },
          "map": {
            "type": [
              "object",
              "null"
            ],
            "description": "Top-down terrain map, present when the export was run with --maps and the stage has spawn points.",
            "additionalProperties": false,
            "required": [
              "image",
              "bounds",
              "width",
              "height",
              "pixelsPerUnit",
              "coverage",
              "fill"
            ],
            "properties": {
              "image": {
                "type": "string",
                "description": "PNG relative to the export directory; transparent where there is no geometry."
              },
              "bounds": {
                "type": "object",
                "required": [
                  "minX",
                  "maxX",
                  "minZ",
                  "maxZ"
                ],
                "additionalProperties": false,
                "properties": {
                  "minX": {
                    "type": "number"
                  },
                  "maxX": {
                    "type": "number"
                  },
                  "minZ": {
                    "type": "number"
                  },
                  "maxZ": {
                    "type": "number"
                  }
                },
                "description": "World rectangle the image covers. Image x grows with world x and image y grows with world z."
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "pixelsPerUnit": {
                "type": "number",
                "description": "Pixels per world unit: pixel = (world - min) * pixelsPerUnit."
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Share of spawn points that land on drawn geometry."
              },
              "fill": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Share of the image covered by geometry. Values near 1 (boss arenas, a few dungeon floors) are flat floors with little structure to show."
              }
            }
          }
        }
      }
    }
  }
}
