{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiatlas.invalid/schema/v1/enemies.schema.json",
  "title": "Enemy stat rows",
  "type": "object",
  "required": [
    "rowCount",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "rowCount": {
      "type": "integer"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "name",
          "kind",
          "model",
          "hp",
          "stats",
          "resist",
          "rates",
          "rarity"
        ],
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0,
            "description": "Row in the platform's stat table. Spawn generators reference this."
          },
          "model": {
            "type": "string",
            "description": "Internal model name; for debugging and icon lookup, not for display."
          },
          "hp": {
            "type": "integer"
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strength",
              "defense",
              "wisdom",
              "spirit",
              "speed",
              "exp"
            ],
            "properties": {
              "strength": {
                "type": "integer"
              },
              "defense": {
                "type": "integer"
              },
              "wisdom": {
                "type": "integer"
              },
              "spirit": {
                "type": "integer"
              },
              "speed": {
                "type": "integer"
              },
              "exp": {
                "type": "integer"
              }
            }
          },
          "rates": {
            "type": "object",
            "required": [
              "crit",
              "paralysis"
            ],
            "properties": {
              "crit": {
                "type": "integer"
              },
              "paralysis": {
                "type": "integer"
              }
            }
          },
          "rarity": {
            "type": "integer",
            "minimum": 0,
            "description": "Crown rank; 0 for most rows."
          },
          "name": {
            "type": "string",
            "description": "Display name shown to players."
          },
          "kind": {
            "enum": [
              "enemy",
              "boss",
              "object"
            ],
            "description": "object = destructible (box, barrel, case)."
          },
          "resist": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fire",
              "ice",
              "thunder",
              "dark",
              "stun",
              "poison"
            ],
            "properties": {
              "fire": {
                "type": "integer"
              },
              "ice": {
                "type": "integer"
              },
              "thunder": {
                "type": "integer"
              },
              "dark": {
                "type": "integer"
              },
              "stun": {
                "type": "integer"
              },
              "poison": {
                "type": "integer"
              }
            },
            "description": "Resistances as stored by the game (units unconfirmed)."
          },
          "form": {
            "type": "string",
            "description": "Tells apart stat rows that share a name, such as a boss's forms (\"Form 1\")."
          },
          "role": {
            "enum": [
              "part"
            ],
            "description": "\"part\": a boss's part or minion (destroy-first orbs, summoned helpers), shown with that boss."
          },
          "partOf": {
            "type": "string",
            "description": "For a part: the display name of its boss."
          },
          "crownStyle": {
            "enum": [
              "random"
            ]
          }
        }
      }
    }
  }
}
