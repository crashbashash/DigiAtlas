{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiatlas.invalid/schema/v1/items.schema.json",
  "title": "Items referenced by drop pools",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "id",
          "name",
          "description"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "minimum": 0,
            "description": "Index within the category; matches drop-pool entries."
          },
          "name": {
            "type": "string",
            "description": "Display name as shown in game."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "In-game description text; lines separated by \\n."
          }
        }
      }
    }
  }
}
