{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiatlas.invalid/schema/v1/items.schema.json",
  "title": "Items referenced by drop pools",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "id",
          "name",
          "description"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "minimum": 0,
            "description": "Index within the category; matches drop-pool entries."
          },
          "name": {
            "type": "string",
            "description": "Display name as shown in game."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "In-game description text; lines separated by \\n."
          },
          "skillType": {
            "enum": [
              "Blunt",
              "Slash",
              "Stab",
              "Bash",
              "Shot",
              "Crush"
            ],
            "description": "Weapons only: the skill the weapon trains and requires."
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "description": "Only non-zero stats are present; absent means 0. Values are as stored by the game.",
            "properties": {
              "strength": {
                "type": "integer"
              },
              "defense": {
                "type": "integer"
              },
              "wisdom": {
                "type": "integer"
              },
              "spirit": {
                "type": "integer"
              },
              "speed": {
                "type": "integer"
              },
              "maxHp": {
                "type": "integer"
              },
              "maxMp": {
                "type": "integer"
              },
              "resistFire": {
                "type": "integer"
              },
              "resistIce": {
                "type": "integer"
              },
              "resistThunder": {
                "type": "integer"
              },
              "resistDark": {
                "type": "integer"
              },
              "resistStun": {
                "type": "integer"
              },
              "resistPoison": {
                "type": "integer"
              },
              "critRate": {
                "type": "integer"
              },
              "paralysisRate": {
                "type": "integer"
              },
              "hitRate": {
                "type": "integer"
              },
              "defenseRate": {
                "type": "integer"
              },
              "paralysisResist": {
                "type": "integer"
              },
              "poisonResist": {
                "type": "integer"
              },
              "bitRate": {
                "type": "integer"
              },
              "expRate": {
                "type": "integer"
              },
              "luckRate": {
                "type": "integer"
              },
              "hpDrain": {
                "type": "integer"
              },
              "mpDrain": {
                "type": "integer"
              },
              "provokeRate": {
                "type": "integer"
              },
              "equipLevel": {
                "type": "integer"
              },
              "requiredSkill": {
                "type": "integer"
              },
              "buyPrice": {
                "type": "integer"
              },
              "sellPrice": {
                "type": "integer"
              },
              "restoreHp": {
                "type": "integer"
              },
              "restoreMp": {
                "type": "integer"
              }
            }
          },
          "unidentified": {
            "const": true,
            "description": "Placeholder drop that a Digimon in the central area identifies as a random weapon, core or board."
          },
          "element": {
            "enum": [
              "fire",
              "ice",
              "thunder",
              "dark"
            ]
          },
          "normalHits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        }
      }
    },
    "appraisal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost",
        "tiers"
      ],
      "description": "What the appraiser turns an unidentified weapon, core or board into. Absent when the platform export does not know.",
      "properties": {
        "cost": {
          "type": "integer",
          "description": "BIT charged per appraisal."
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tier",
              "minLevel",
              "maxLevel",
              "results"
            ],
            "properties": {
              "tier": {
                "type": "integer",
                "minimum": 1
              },
              "minLevel": {
                "type": "integer",
                "minimum": 0
              },
              "maxLevel": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Highest player level this tier applies to; null for the last tier."
              },
              "results": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "weapon",
                  "armor1",
                  "armor2"
                ],
                "properties": {
                  "weapon": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "category",
                        "id",
                        "rate"
                      ],
                      "properties": {
                        "category": {
                          "enum": [
                            "weapon",
                            "armor1",
                            "armor2"
                          ]
                        },
                        "id": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Item id in the category; with `category` it is the key of an entry in `items`."
                        },
                        "rate": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000,
                          "description": "Weight out of 10000."
                        }
                      }
                    }
                  },
                  "armor1": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "category",
                        "id",
                        "rate"
                      ],
                      "properties": {
                        "category": {
                          "enum": [
                            "weapon",
                            "armor1",
                            "armor2"
                          ]
                        },
                        "id": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Item id in the category; with `category` it is the key of an entry in `items`."
                        },
                        "rate": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000,
                          "description": "Weight out of 10000."
                        }
                      }
                    }
                  },
                  "armor2": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "category",
                        "id",
                        "rate"
                      ],
                      "properties": {
                        "category": {
                          "enum": [
                            "weapon",
                            "armor1",
                            "armor2"
                          ]
                        },
                        "id": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Item id in the category; with `category` it is the key of an entry in `items`."
                        },
                        "rate": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000,
                          "description": "Weight out of 10000."
                        }
                      }
                    }
                  }
                },
                "description": "Possible results by kind of unidentified item; the weights of each list add up to 10000."
              }
            }
          }
        }
      }
    },
    "powerSpells": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "grade",
          "row",
          "baseFrames"
        ],
        "properties": {
          "kind": {
            "enum": [
              "up",
              "down"
            ]
          },
          "grade": {
            "enum": [
              "Petty",
              "Mega",
              "Giga",
              "Terra",
              "Infinity"
            ]
          },
          "row": {
            "type": "integer",
            "minimum": 80,
            "maximum": 89
          },
          "baseFrames": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "saveStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forms",
        "wisdomBoards"
      ],
      "properties": {
        "forms": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "species",
              "name",
              "model",
              "wisdomInitial",
              "wisdomGrowth"
            ],
            "properties": {
              "species": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "name": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "wisdomInitial": {
                "type": "integer"
              },
              "wisdomGrowth": {
                "type": "integer"
              },
              "strengthInitial": {
                "type": "integer"
              },
              "strengthGrowth": {
                "type": "integer"
              },
              "speedInitial": {
                "type": "integer"
              },
              "speedGrowth": {
                "type": "integer"
              }
            }
          }
        },
        "wisdomBoards": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "strengthBoards": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "speedBoards": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
