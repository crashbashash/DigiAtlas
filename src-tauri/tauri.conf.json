{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigiAtlas",
  "version": "0.3.0",
  "identifier": "io.github.crashbashash.digiatlas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DigiAtlas",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5175 ws://127.0.0.1:5175;"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Maps, game data and calculators for Digimon World 4",
    "windows": {
      "wix": {
        "upgradeCode": "d4cf3c5f-c19d-418c-8202-9e4bfcdc0897"
      }
    },
    "publisher": "DigiAtlas contributors"
  }
}
