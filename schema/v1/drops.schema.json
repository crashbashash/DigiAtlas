{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiatlas.invalid/schema/v1/drops.schema.json",
  "title": "Drop pools",
  "type": "object",
  "required": [
    "pools"
  ],
  "additionalProperties": false,
  "properties": {
    "pools": {
      "type": "object",
      "description": "Keyed by import-local pool identity. Original names are retained when contents match; conflicting tables receive distinct keys.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "entries",
          "totalRate"
        ],
        "additionalProperties": false,
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "id",
                "rank",
                "rate"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "description": "conItem, insItem, impItem, weapon, armor1, armor2 or abChip."
                },
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "rank": {
                  "type": "integer"
                },
                "rate": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000,
                  "description": "Stored weight. Use the pool's roll rule to calculate its actual probability."
                }
              }
            }
          },
          "totalRate": {
            "type": "integer",
            "description": "Sum of stored weights; actual no-drop probability depends on the roll rule."
          },
          "roll": {
            "const": "inclusive",
            "description": "Roll 0..9999, subtract each weight in order and select on <= 0. Includes the extra zero roll and cumulative truncation."
          },
          "difficulty": {
            "enum": [
              "normal",
              "hard",
              "veryhard"
            ]
          },
          "zone": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "variant": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
