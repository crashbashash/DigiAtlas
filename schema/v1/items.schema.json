{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digiatlas.invalid/schema/v1/items.schema.json",
  "title": "Items referenced by drop pools",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "id",
          "name"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name; null until resolved."
          }
        }
      }
    }
  }
}
